# Copy to .env.local and fill in. Never commit the filled-in file.

# Local development uses the Postgres container from docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bazarsip

# Generate with: openssl rand -base64 32
# Use a different value in production than in development.
JWT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3000

# From the Cloudinary dashboard. The secret is server-side only — it must
# never carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The address visitors actually type. Needed for the Google callback,
# because a route handler only ever sees the internal http://localhost:PORT
# and would register that with Google instead.
#   development: http://localhost:3000
#   production:  https://yourdomain.com
APP_URL=

# Sign in with Google. Leave both blank and the button does not appear.
#
# Create them at console.cloud.google.com:
#   APIs & Services > Credentials > Create credentials > OAuth client ID
#   Application type: Web application
#   Authorized redirect URI (exactly, one per environment):
#     http://localhost:3000/api/auth/google/callback
#     https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
